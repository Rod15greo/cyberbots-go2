# ============================================================
# CyberBots Go2 — Configuração
# Copie este arquivo para .env e preencha os valores reais
# cp .env.example .env
# ============================================================

# ── Servidor EC2 (sinalização WebRTC) ────────────────────────
SERVER_URL=http://SEU_IP_EC2:8000
WS_PUBLISHER_URL=ws://SEU_IP_EC2:8000/ws/publisher

# ── TURN Server (coturn no EC2) ───────────────────────────────
TURN_URL=turn:SEU_IP_EC2:3478
TURN_USER=robot
TURN_PASS=SUA_SENHA_TURN

# ── Go2 — Modo de conexão ─────────────────────────────────────
# Deixar GO2_IP vazio = modo AP (Jetson se conecta direto ao hotspot do robô)
# Preencher GO2_IP = modo STA (Go2 conectado ao seu roteador WiFi)
GO2_IP=

# Chave AES — necessária apenas em firmware >= 1.1.15
# Obter com: unitree-fetch-aes-key --email SEU@EMAIL.com --password 'SENHA'
GO2_AES_KEY=

# ── Reconhecimento Facial ─────────────────────────────────────
FACES_DIR=./faces
CONFIDENCE_THRESHOLD=0.45

# Modelo: buffalo_l (mais preciso) ou buffalo_s (mais rápido)
INSIGHTFACE_MODEL=buffalo_l

# Tamanho de detecção — 640 recomendado, 320 para mais velocidade
DET_SIZE=640
